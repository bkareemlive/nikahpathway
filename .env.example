# Supabase — from your project's Settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never expose to the browser. Used for admin scripts / webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the app is served (used for auth email redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (payments) ---------------------------------------------------------
# From https://dashboard.stripe.com/test/apikeys  (use test keys first)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint's signing secret in prod
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price ids — create with `node scripts/stripe-setup.mjs` (prints these)
STRIPE_PRICE_FULL_MONTHLY=price_xxx
STRIPE_PRICE_FULL_6MO=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx
# Launch-promo prices (only used while promo.active in src/data/pricing.ts)
STRIPE_PRICE_FULL_MONTHLY_PROMO=price_xxx
STRIPE_PRICE_FULL_6MO_PROMO=price_xxx
STRIPE_PRICE_LIFETIME_PROMO=price_xxx

# --- Google Play Billing (Android app payments) -------------------------------
# Web/Stripe is unaffected; this is only used inside the Android app, where
# Apple In-App Purchase (iOS app). See store-assets/ios/app-store-billing.md.
# App Store Connect > Users and Access > Integrations > In-App Purchase:
# generate a key, then copy its Issuer ID, Key ID and the downloaded .p8 file's
# contents (one line, with literal \n between lines).
APP_STORE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APP_STORE_KEY_ID=ABC123DEFG
APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Google Play's Payments policy requires "dating" subscriptions to use Play
# Billing. See store-assets/android/google-play-billing.md for full setup.
#
# Google Cloud Console > IAM > Service Accounts: create one, grant it
# "Service Account User", then in Play Console > Setup > API access, link it
# with "View financial data" + "Manage orders and subscriptions" permissions.
# Paste its downloaded JSON key file's contents here as one line.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# The same service account's email, used to verify that Real-time Developer
# Notifications pushes genuinely come from Google Cloud Pub/Sub and not a
# forged request (see src/app/api/google-play/notifications/route.ts).
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=xxx@xxx.iam.gserviceaccount.com
# The audience configured on the Pub/Sub push subscription's OIDC token
# (set this to the full webhook URL, e.g. https://nikahpathway.com/api/google-play/notifications).
GOOGLE_PLAY_RTDN_AUDIENCE=https://nikahpathway.com/api/google-play/notifications
