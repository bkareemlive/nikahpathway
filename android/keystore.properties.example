# Copy this file to android/keystore.properties (same folder) and fill in
# the real values. keystore.properties is gitignored — never commit it.
#
# storeFile can be an absolute path (Windows backslashes must be doubled,
# e.g. C:\\Users\\you\\path\\to\\nikahpathway-release.jks) or a path
# relative to this android/ folder.
storeFile=C:\\Users\\Owner\\iCloudDrive\\NikahPathway-signing\\nikahpathway-release.jks
storePassword=
keyAlias=
keyPassword=
